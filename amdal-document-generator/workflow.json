    {
      "parameters": {
        "jsCode": "const raw = items[0].json.text; // adjust if your Basic LLM Chain output field isn't named \"text\"\n\n// Strip markdown code fences if present\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error(\"Failed to parse AI JSON output: \" + e.message + \"\\nRaw text: \" + cleaned);\n}\n\nreturn [{\n  json: {\n    ...items[0].json, // keep original fields flowing through\n    ...parsed          // add narasi_ fields as top-level keys\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
